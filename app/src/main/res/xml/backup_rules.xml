<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy backup rules for API <= 30, where android:fullBackupContent is the
     only mechanism. Kept in sync with res/xml/data_extraction_rules.xml (API 31+). -->
<full-backup-content>
    <!-- §12/§0: the vault never leaves the device. -->
    <exclude domain="file" path="datastore/vault.preferences_pb" />
    <exclude domain="sharedpref" path="botati_vault_keyset_prefs.xml" />
    <!-- SEC-01/BOT-08: the Room database holds mail bodies, tool arguments and
         the audit trail. Excluding only the vault left the actual private
         content eligible for backup. The -wal and -shm siblings must be
         excluded too: a write-ahead log that has not been checkpointed still
         contains the same rows. -->
    <exclude domain="database" path="botati.db" />
    <exclude domain="database" path="botati.db-wal" />
    <exclude domain="database" path="botati.db-shm" />
</full-backup-content>
